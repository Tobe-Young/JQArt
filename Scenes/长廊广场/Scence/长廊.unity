  m_Name: 
  m_EditorClassIdentifier: 
  htmlContent: "\r\n         <!DOCTYPE html>\r\n        <html>\r\n        <head>\r\n           
    <meta charset='utf-8'>\r\n             <meta name='viewport' content='width=device-width,
    initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover'>\r\n           
    <style>\r\n                html, body {\r\n                    width: 100%;\r\n                   
    height: 100%;\r\n                }\r\n                body {\r\n                   
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;\r\n                   
    padding: 16px;\r\n                    margin: 0;\r\n                    font-size:
    16px;\r\n                    line-height: 1.5;\r\n                    box-sizing:
    border-box;\r\n                    width: 100vw;\r\n                    min-height:
    100vh;\r\n                    overflow-x: hidden;\r\n                    overflow-y:
    auto;\r\n                    -webkit-overflow-scrolling: touch;\r\n                   
    background-color: white; color: black;\r\n                }\r\n               
    p { margin: 0 0 1em 0; }\r\n                /* Some server html sets img width/height
    attrs; force full-width and keep aspect ratio. */\r\n                img {\r\n                   
    display: block !important;\r\n                    width: 100% !important;\r\n                   
    max-width: 100% !important;\r\n                    height: auto !important;\r\n                   
    margin: 0 auto;\r\n                }\r\n                /* Prevent accidental
    horizontal overflow from inline styles. */\r\n                * { max-width:
    100%; box-sizing: border-box; }\r\n            </style>\r\n        </head>\r\n       
    <body>\r\n        <p style=\"text-align: center;\"></p><p style=\"text-align:
    center;\"><img src=\"http://jqsj-beijing.oss-cn-beijing.aliyuncs.com/jiuqishujie-file/17587151971682437.png\"
    alt=\"\" title=\"\" width=\"437\" height=\"1558\" data-display=\"inline\"></p><p></p><p
    style=\"text-align: center;\"></p><p></p>\r\n        </body>\r\n        </html>"
